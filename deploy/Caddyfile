# Let's Encrypt 인증서를 Caddy 가 알아서 발급하고 갱신한다.
# ALB($18/월) 와 ACM 없이 HTTPS 를 얻는 자리다.
{$DOMAIN} {
	encode gzip

	# 운영에서는 스웨거를 꺼 두지만(application.yml), 경로 자체를 막아 한 겹 더 준다.
	@blocked path /swagger-ui* /v3/api-docs*
	respond @blocked 404

	# actuator 는 헬스체크만 열고 나머지는 밖에서 못 부르게 한다.
	@actuator path /actuator/*
	@health path /actuator/health /actuator/health/*
	handle @health {
		reverse_proxy app:8080
	}
	handle @actuator {
		respond 404
	}

	reverse_proxy app:8080 {
		# 앱이 Secure 쿠키를 내려면 프록시 앞단이 https 였다는 걸 알아야 한다.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}
