# Let's Encrypt 인증서를 Caddy 가 알아서 발급하고 갱신한다.
# ALB($18/월) 와 ACM 없이 HTTPS 를 얻는 자리다.
#
# handle 블록만 쓴다. 위에서부터 첫 매치 하나만 실행되므로 순서가 곧 우선순위다.
# respond 같은 디렉티브를 섞으면 Caddy 의 고정 순서 규칙에 걸려 의도와 다르게 평가된다.
(app) {
	encode gzip

	# 스웨거는 프론트 연동용으로 열되 기본인증을 건다.
	# 계정은 Parameter Store 의 SWAGGER_PASSWORD_HASH (bcrypt) 로 주입한다 —
	# 평문은 저장소에도 서버에도 두지 않는다.
	#
	# 심사 API 도 문서에 보이지만 호출은 앱이 막는다 (D-055). 세션 인증이라 계정이 따로 없다.
	@swagger path /swagger-ui* /v3/api-docs*
	handle @swagger {
		basic_auth {
			moeum {$SWAGGER_PASSWORD_HASH}
		}
		reverse_proxy app:8080
	}

	# 운영자용 심사 API (D-055).
	#
	# 앱이 직접 지킨다 — 세션의 카카오 회원번호가 운영자 명단에 있어야 통과한다.
	# 여기서 basic_auth 를 걸면 프론트가 자기 도메인에서 이 API 를 부를 수 없다.
	# 브라우저 프리플라이트에는 Authorization 이 실리지 않아 401 이 되기 때문이다.
	#
	# 이 블록을 굳이 남기는 이유는 순서다. 지우면 아래 기본 handle 로 떨어져 같은 곳으로
	# 가지만, /admin/* 이 어디서 처리되는지 한눈에 보이지 않게 된다.
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy app:8080
	}

	# actuator 는 헬스체크만 열고 나머지(env, metrics 등)는 밖에서 못 부르게 한다.
	@health path /actuator/health /actuator/health/*
	handle @health {
		reverse_proxy app:8080
	}

	@actuator path /actuator/*
	handle @actuator {
		respond 404
	}

	handle {
		reverse_proxy app:8080 {
			# 앱이 Secure 쿠키를 내려면 프록시 앞단이 https 였다는 걸 알아야 한다.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}

# 운영 API. 프론트(www.moeum.store)와 등록 도메인이 같아야 세션 쿠키가 전송된다.
# 다른 도메인이면 SameSite=Lax 가 cross-site 로 판정해 쿠키를 싣지 않는다.
{$DOMAIN} {
	import app
}

# 예전 도메인. 아직 살아 있어 인증서를 유지하되 API 로 쓰지는 않는다.
# 여기로 들어와도 동작은 하지만 프론트와 cross-site 라 로그인은 되지 않는다.
{$LEGACY_DOMAIN} {
	import app
}
