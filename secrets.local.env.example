# 로컬 개발용 자격증명. 이 파일을 secrets.local.env 로 복사해서 값을 채운다.
#
#   cp secrets.local.env.example secrets.local.env
#
# secrets.local.env 는 .gitignore 에 걸려 있어 커밋되지 않는다.
# 값에 따옴표를 붙이지 않는다. # 로 시작하는 줄과 빈 줄은 무시한다.

# ─── 스마트택배 배송조회 (D-048) ────────────────────────────────
# 키와 스위치가 둘 다 있어야 켜진다. 키만 넣으면 아직 안 나간다.
SMART_TRACKER_API_KEY=
SMART_TRACKER_ENABLED=true

# ─── 카카오 알림톡 / SOLAPI (D-040) ─────────────────────────────
# ★ NOTIFY_PROVIDER 를 solapi 로 바꾸기 전에 아래 네 개를 다 채운다.
#   하나라도 비면 발송이 예외로 떨어지고, outbox 가 8회 재시도한 뒤
#   DEAD 로 쌓인다 — 그 알림은 영영 안 나간다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_FROM=

# 승인된 템플릿만 채운다. 빈 항목은 로그만 남기고 조용히 넘어간다(정상)
SOLAPI_TEMPLATE_ORDER_PAID=
SOLAPI_TEMPLATE_SECOND_PAYMENT_DUE=
SOLAPI_TEMPLATE_SECOND_PAID=
SOLAPI_TEMPLATE_SHIPPED=
SOLAPI_TEMPLATE_PROGRESS_CHANGED=
SOLAPI_TEMPLATE_RECRUITMENT_SUCCEEDED=
SOLAPI_TEMPLATE_RECRUITMENT_FAILED=
SOLAPI_TEMPLATE_SECOND_PAYMENT_OVERDUE=
SOLAPI_TEMPLATE_REFUND_COMPLETED=

# ★ 값이 있으면 모든 알림이 이 번호로만 간다 — 구매자에게는 한 통도 안 간다.
#   자격증명을 다 채우기 전까지는 여기를 비우지 않는 편이 안전하다.
SOLAPI_TEST_RECIPIENT=

# 실발송 스모크 테스트 수신번호. 있을 때만 SolapiSmokeTest 가 돈다.
# ★ 돌리면 실제로 돈이 나가고 사람에게 도착한다. 평소에는 비워 둔다.
SOLAPI_SMOKE_TO=

# ─── 마지막에 켠다 ──────────────────────────────────────────────
# log | solapi. 위가 다 채워진 것을 확인한 뒤 solapi 로 바꾼다.
NOTIFY_PROVIDER=log
