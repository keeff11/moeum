// =====================================================================
// 공동구매 · 단독 판매 플랫폼 ERD (MySQL 8.0)
//
// docs/schema.sql 과 같은 스냅샷이다. 스키마의 원본은
// moeum/src/main/resources/db/migration/ 이고 여기는 V1~V10 을 전부 적용한
// 결과를 관계 중심으로 다시 그린 것이다.
// 스키마를 바꿀 때는 새 마이그레이션 파일을 만들고 이 파일과 schema.sql 을
// 같이 고친다 — 어긋나면 FlywayMigrationTest 가 깨진다.
// =====================================================================

Table "seller" {
  "id" BIGINT [pk, not null, increment]
  "kakao_id" VARCHAR(64) [not null]
  "store_slug" VARCHAR(64) [not null, note: '판매공간 URL 식별자']
  "store_name" VARCHAR(60) [note: '공개 표시용 상호명. 비면 store_slug 로 대체']
  "review_status" VARCHAR(20) [not null, default: 'PENDING', note: 'PENDING, APPROVED, REJECTED']
  "shipping_fee" INT [not null, default: 0, note: '주문 묶음당 1회 부과']
  "free_shipping_over" INT [note: '이 금액 이상 무료. NULL이면 미적용']
  "business_no_enc" VARBINARY(255) [note: '사업자번호(암호화)']
  "settlement_acct_enc" VARBINARY(255) [note: '정산계좌(암호화)']
  "representative_name" VARCHAR(50)
  "phone" VARCHAR(20) [note: '심사·정산 담당자 연락처. 공개하지 않는다']
  "email" VARCHAR(120)
  "approved_at" DATETIME(6)
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "bio" VARCHAR(100) [note: '한 줄 소개. 셀러 페이지 헤더에 노출된다']
  "social_url" VARCHAR(200) [note: '인스타 등 소셜 주소. 헤더 버튼에 걸린다']
  "profile_image_key" VARCHAR(500) [note: 'S3 객체 키. 전체 URL 을 저장하지 않는다']
  "public_contact" VARCHAR(100) [note: '구매자 문의 연락처. 심사용 phone 과 별개로 공개된다']

  Indexes {
    kakao_id [unique, name: "uk_seller_kakao"]
    store_slug [unique, name: "uk_seller_slug"]
  }

  Note: '판매자 계정이자 배송비의 주체다. 한 셀러 주문은 배송비를 1회만 받는다. 심사·정산용 값(대표자 실명·연락처·사업자번호·정산계좌)과 구매자에게 보이라고 받는 공개 값(상호명·소개·소셜·프로필 이미지·문의 연락처)이 한 테이블에 있고 응답 DTO 에서 갈린다 — 심사용은 공개 응답에 담기지 않는다.'
}

Table "sale_form" {
  "id" BIGINT [pk, not null, increment]
  "seller_id" BIGINT [not null]
  "title" VARCHAR(200) [not null]
  "slug" VARCHAR(120) [not null]
  "sale_type" VARCHAR(10) [not null, note: 'GROUP, SOLO']
  "status" VARCHAR(20) [not null, default: 'DRAFT', note: 'DRAFT, SELLING, PAUSED, CLOSED, ENDED']
  "stock_max" INT [not null]
  "held" INT [not null, default: 0, note: '결제 확정 전 선점 수량']
  "sold" INT [not null, default: 0]
  "target_qty" INT [note: '목표수량(최소). SOLO 는 NULL']
  "max_per_user" INT [note: '1인당 구매 상한. NULL이면 무제한']
  "opens_at" DATETIME(6)
  "closes_at" DATETIME(6)
  "extended_count" INT [not null, default: 0]
  "shortfall_policy" VARCHAR(10) [note: 'CANCEL, EXTEND, PROCEED']
  "ship_start_text" VARCHAR(100) [note: '8월 20일(월) 순차발송 — 서버가 포맷']
  "min_order_amount" INT [not null, default: 0]
  "description_json" JSON [note: 'Lexical JSON (ADR 0001)']
  "progress_public" TINYINT(1) [not null, default: 1]
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "shortfall_done_at" DATETIME(6) [note: '목표수량 미달 처리를 끝낸 시각. NULL 이면 아직 안 훑었다']

  Indexes {
    (seller_id, slug) [unique, name: "uk_sale_form_slug"]
    (status, closes_at) [name: "idx_sale_form_status"]
    (status, shortfall_done_at) [name: "idx_sale_form_shortfall"]
  }

  Note: '판매 단위이자 재고 확보의 주체. 셀러가 링크 하나를 발급하면 이 행이 하나 생긴다. 가용 재고 = stock_max - held - sold 이며 확보는 조건부 UPDATE로 처리한다. 구매자가 보는 상품의 실체가 이 폼이라 찜도 같은 단위다. shortfall_done_at 은 미달 처리 배치의 멱등 가드로, 정책과 무관하게 한 번 훑으면 채운다 — 이미 결제된 돈을 돌려주는 일이라 두 번 돌면 안 된다.'
}

Table "sale_form_history" {
  "id" BIGINT [pk, not null, increment]
  "sale_form_id" BIGINT [not null]
  "field" VARCHAR(50) [not null]
  "old_value" VARCHAR(500)
  "new_value" VARCHAR(500)
  "changed_by" BIGINT [note: 'seller.id']
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (sale_form_id, created_at) [name: "idx_history_form"]
  }

  Note: '판매 설정 변경 이력. 셀러 대시보드의 「변경 이력」 탭을 채우고, 마감일이나 가격을 바꿨을 때 분쟁 근거가 된다.'
}

Table "sale_form_image" {
  "id" BIGINT [pk, not null, increment]
  "sale_form_id" BIGINT [not null]
  "object_key" VARCHAR(500) [not null, note: 'S3 객체 키. 전체 URL 을 저장하지 않는다']
  "sort_order" INT [not null, default: 0]
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (sale_form_id, sort_order) [name: "idx_sale_form_image_form"]
  }

  Note: '상품 이미지. 순서가 곧 노출 순서이고 images[0] 이 대표 이미지다. 전체 URL 이 아니라 객체 키만 담아, 버킷을 바꾸거나 CDN 을 앞에 세워도 쌓인 행을 고치지 않는다. 폼이 지워지면 같이 지운다 — 이미지만 남아 있을 이유가 없다.'
}

Table "product" {
  "id" BIGINT [pk, not null, increment]
  "sale_form_id" BIGINT [not null]
  "name" VARCHAR(200) [not null]
  "sort_order" INT [not null, default: 0]
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (sale_form_id, sort_order) [name: "idx_product_form"]
  }

  Note: '판매 폼 안의 개별 상품. 가격을 갖지 않는다 — 금액은 전부 옵션이 절대값으로 갖는다. 재고도 여기가 아니라 sale_form 단위다.'
}

Table "product_option" {
  "id" BIGINT [pk, not null, increment]
  "product_id" BIGINT [not null]
  "name" VARCHAR(100) [not null]
  "deposit1_amount" INT [not null, note: '1차금 절대값 — 주문 시 결제']
  "deposit2_amount" INT [not null, default: 0, note: '2차금 상품 잔금. 1차금이 전액이면 0']
  "sort_order" INT [not null, default: 0]

  Indexes {
    (product_id, sort_order) [name: "idx_option_product"]
  }

  Note: '금액을 갖는 유일한 자리. 기준가 + 추가금이 아니라 절대값이고, 1차금과 2차금으로 나뉜다. 옵션 자체 재고는 없고 배송비도 없다 — 배송비는 셀러 단위다.'
}

Table "buyer" {
  "id" BIGINT [pk, not null, increment]
  "kakao_id" VARCHAR(64) [not null]
  "nickname" VARCHAR(50) [note: '카카오 프로필. 수령인 이름과는 별개']
  "payer_id" VARCHAR(64) [note: 'point3 결제자 식별값. 받은 문자열 그대로 저장']
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    kakao_id [unique, name: "uk_buyer_kakao"]
  }

  Note: '구매자 계정. payer_id를 저장해 두면 다음 결제에서 인증 단계가 줄어든다. point3가 준 문자열을 가공하지 말 것. 수령인 이름과 연락처는 여기가 아니라 buyer_address 에 있다.'
}

Table "buyer_address" {
  "id" BIGINT [pk, not null, increment]
  "buyer_id" BIGINT [not null]
  "recipient_name" VARCHAR(50) [not null]
  "phone" VARCHAR(20) [not null]
  "postal_code" VARCHAR(10)
  "address1" VARCHAR(255) [not null]
  "address2" VARCHAR(255)
  "memo" VARCHAR(200)
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    buyer_id [unique, name: "uk_address_buyer"]
  }

  Note: '구매자당 1건인 배송지 마스터. /me/address 가 이 행을 읽고 쓴다. 주문 시 shipping 으로 스냅샷 복사되며, 그 뒤 이 행을 고쳐도 이미 발송된 주문의 주소는 흔들리지 않는다.'
}

Table "wishlist" {
  "id" BIGINT [pk, not null, increment]
  "buyer_id" BIGINT [not null]
  "sale_form_id" BIGINT [not null]
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (buyer_id, sale_form_id) [unique, name: "uk_wishlist"]
    sale_form_id [name: "idx_wishlist_form"]
  }

  Note: '찜(하트). 판매 폼 단위다 — 재고·마감·목표수량이 전부 폼 단위라 구매자가 보는 상품의 실체가 폼이다. 셀러 페이지 목록 응답에는 넣지 않는다. 넣는 순간 그 응답이 사용자별로 갈려 모두에게 같은 응답을 줄 수 없다. 중복 방지는 유니크 제약이 전부다 — 두 요청이 동시에 통과할 수 있어 최종 판정은 DB에 맡긴다. 폼 기준 인덱스는 마감 시 찜한 사람에게 알리려고 둔다.'
}

Table "cart" {
  "id" BIGINT [pk, not null, increment]
  "buyer_id" BIGINT [not null]
  "seller_id" BIGINT [not null]
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (buyer_id, seller_id) [unique, name: "uk_cart_buyer_seller"]
  }

  Note: '장바구니 헤더. 배송비를 한 번만 받기 위해 셀러 단위로 묶는다. 다른 셀러 상품을 담으면 기존 장바구니를 비우지 않고 새 장바구니가 생긴다.'
}

Table "cart_item" {
  "id" BIGINT [pk, not null, increment]
  "cart_id" BIGINT [not null]
  "sale_form_id" BIGINT [not null, note: '담을 때 cart.seller_id 와 일치하는지 검증']
  "product_id" BIGINT [not null]
  "option_id" BIGINT [not null]
  "qty" INT [not null]
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (cart_id, option_id) [unique, name: "uk_cart_item"]
    sale_form_id [name: "idx_cart_item_form"]
  }

  Note: '장바구니에 담긴 옵션과 수량. 옵션이 금액을 갖는 단위라 중복 판정도 옵션 기준이다. 재고를 잡지 않으므로 담아둔 사이 마감·품절될 수 있고, 실제 검증은 주문 생성 시점에 한다.'
}

Table "order_group" {
  "id" BIGINT [pk, not null, increment]
  "session_token" VARCHAR(40) [not null, note: 'cs_xxx — B2 옵션·수량 확정 시 발급']
  "order_token" VARCHAR(40) [note: 'ord_xxx — /pay 시점에 발급']
  "buyer_id" BIGINT [not null]
  "seller_id" BIGINT [not null, note: '한 묶음은 한 셀러로 제한']
  "deposit1_total" INT [not null, note: '1차금 합계 — B5 청구액']
  "deposit2_total" INT [not null, default: 0, note: '2차금 상품 잔금 합계']
  "shipping_fee" INT [not null, default: 0, note: '셀러 배송비 1회분 스냅샷']
  "status" VARCHAR(20) [not null, default: 'CREATED', note: 'CREATED, PAY_PENDING, CONFIRMING, PAID, SECOND_PENDING, SECOND_PAID, SHIPPED, CANCELED, EXPIRED, FAILED']
  "fail_reason" VARCHAR(100)
  "canceled_at" DATETIME(6)
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "order_no" VARCHAR(20) [note: '사람이 읽는 주문번호 ORD-YYMMDD-{id}. /pay 에서 발급, 그 전에는 NULL']

  Indexes {
    session_token [unique, name: "uk_group_session"]
    order_token [unique, name: "uk_group_order"]
    order_no [unique, name: "uk_group_order_no"]
    (buyer_id, created_at) [name: "idx_group_buyer"]
    (seller_id, status) [name: "idx_group_seller"]
    (seller_id, created_at) [name: "idx_group_seller_created"]
    (status, updated_at) [name: "idx_group_status_updated"]
  }

  Note: '결제 1회 · 배송지 1개 · 배송비 1회의 단위이자 체크아웃 세션 그 자체다(CREATED 상태). 별도 테이블을 두지 않는다. 2차 결제 청구액 = deposit2_total + shipping_fee. 토큰 둘은 주소창에 실리는 임의 문자열이라 전화로 주고받을 수 없어, 사람이 읽는 order_no 를 따로 둔다 — 결제 전 세션에는 붙이지 않는다. 15분 뒤 사라질 자리에 번호를 붙이면 번호가 구멍투성이가 된다. 셀러 주문 목록은 seller_id 와 created_at 으로 훑는다.'
}

Table "orders" {
  "id" BIGINT [pk, not null, increment]
  "order_group_id" BIGINT [not null]
  "sale_form_id" BIGINT [not null]
  "qty" INT [not null, note: '이 폼에서 확보한 총 수량']
  "deposit1_sum" INT [not null]
  "deposit2_sum" INT [not null, default: 0]
  "status" VARCHAR(20) [not null, default: 'CREATED', note: 'CREATED, PAID, RECRUITING, CLOSED, PRODUCING, ARRIVED, SHIPPED, CANCELED, EXPIRED']
  "canceled_at" DATETIME(6)
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (order_group_id, sale_form_id) [unique, name: "uk_orders_group_form"]
    (sale_form_id, status) [name: "idx_orders_form"]
  }

  Note: '판매 폼별 주문. 모집→마감→발주→제작→입고 상태 머신이 여기서 돈다. A폼은 마감, B폼은 모집중일 수 있어 묶음 하나의 status로는 표현할 수 없기 때문에 분리했다. 2차금은 묶음의 모든 폼이 ARRIVED 여야 열린다.'
}

Table "order_item" {
  "id" BIGINT [pk, not null, increment]
  "order_id" BIGINT [not null]
  "product_id" BIGINT [not null]
  "option_id" BIGINT [not null]
  "qty" INT [not null]
  "deposit1_amount" INT [not null, note: '주문 시점 스냅샷']
  "deposit2_amount" INT [not null, default: 0, note: '주문 시점 스냅샷']
  "product_name" VARCHAR(200) [not null, note: '표시용 스냅샷']
  "option_name" VARCHAR(100) [not null, note: '표시용 스냅샷']

  Indexes {
    order_id [name: "idx_item_order"]
    (product_id, option_id) [name: "idx_item_option"]
  }

  Note: '주문에 담긴 옵션 한 줄. 금액과 이름을 주문 시점 값으로 복사해 두어, 셀러가 가격을 바꾸거나 옵션을 삭제해도 과거 주문 내역이 깨지지 않게 한다. 발주서의 옵션별 수량 집계도 이 스냅샷 이름으로 묶는다.'
}

Table "stock_hold" {
  "id" BIGINT [pk, not null, increment]
  "order_id" BIGINT [not null]
  "sale_form_id" BIGINT [not null]
  "qty" INT [not null]
  "status" VARCHAR(20) [not null, default: 'HELD', note: 'HELD, COMMITTED, RELEASED']
  "expires_at" DATETIME(6) [not null, note: '기본 15분']
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    order_id [unique, name: "uk_hold_order"]
    (status, expires_at) [name: "idx_hold_expire"]
  }

  Note: '결제 전 재고 선점 기록. sale_form.held와 짝을 이룬다. 만료 배치는 승인 결과가 미확정(CAPTURE_PENDING)인 묶음의 홀드를 건드리면 안 된다 — 초과 판매의 원인이 된다.'
}

Table "payment" {
  "id" BIGINT [pk, not null, increment]
  "order_group_id" BIGINT [not null]
  "phase" VARCHAR(10) [not null, note: 'FIRST, SECOND']
  "session_id" VARCHAR(128) [note: 'point3 sessionId']
  "amount" INT [not null]
  "supply_amount" INT
  "vat" INT
  "tax_free_amount" INT [not null, default: 0]
  "status" VARCHAR(20) [not null, default: 'CREATED', note: 'CREATED, CAPTURE_PENDING, CAPTURED, FAILED']
  "fail_reason" VARCHAR(100)
  "refunded_amount" INT [not null, default: 0]
  "captured_at" DATETIME(6)
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (order_group_id, phase) [unique, name: "uk_payment_group_phase"]
    session_id [unique, name: "uk_payment_session"]
    (status, updated_at) [name: "idx_payment_pending"]
  }

  Note: 'point3 결제 1건. 묶음당 최대 2행(1차금·2차금). CAPTURE_PENDING은 point3에 없는 우리만의 상태로, 승인 API 호출 직전에 커밋해 두어야 서버가 죽어도 대사 배치가 복구할 수 있다. 세금 3종을 저장하는 이유는 취소 API가 자동 계산을 하지 않기 때문이다. 재결제는 이 행을 재사용하되 FAILED 일 때만이다 — CAPTURE_PENDING 은 절대 덮지 않는다.'
}

Table "payment_event" {
  "id" BIGINT [pk, not null, increment]
  "payment_id" BIGINT [not null]
  "from_status" VARCHAR(20)
  "to_status" VARCHAR(20) [not null]
  "reason" VARCHAR(200)
  "actor" VARCHAR(10) [not null, note: 'USER, BATCH, SELLER, SYSTEM']
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (payment_id, created_at) [name: "idx_event_payment"]
  }

  Note: '결제 상태 전이 로그. 누가(사용자·배치·셀러) 언제 왜 바꿨는지 남긴다. 분쟁 시 유일한 근거이며 토큰·PIN·전체 payer_id는 절대 기록하지 않는다.'
}

Table "refund" {
  "id" BIGINT [pk, not null, increment]
  "payment_id" BIGINT [not null]
  "order_id" BIGINT [note: '특정 폼만 취소한 경우. 전액 취소면 NULL']
  "point3_refund_id" VARCHAR(128)
  "idempotency_key" VARCHAR(300) [note: '중복 차단용. 재시도용 아님']
  "amount" INT [not null]
  "tax_free_amount" INT [not null, default: 0]
  "vat" INT [not null, default: 0]
  "reason" VARCHAR(200) [note: '최대 200자']
  "requested_by" VARCHAR(10) [not null, note: 'BUYER, SELLER, SYSTEM']
  "status" VARCHAR(20) [not null, default: 'PROCESSING', note: 'PROCESSING, COMPLETED, FAILED']
  "settled_manual" TINYINT(1) [not null, default: 0, note: '정산 완료 후 셀러 직접 환불 접수건']
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    idempotency_key [unique, name: "uk_refund_idem"]
    (payment_id, created_at) [name: "idx_refund_payment"]
    (status, updated_at) [name: "idx_refund_pending"]
  }

  Note: '취소·환불 내역. 부분 취소가 기본이라 payment당 N행이 쌓인다. 결과가 불확실할 때 같은 키로 재요청하면 409가 나므로 반드시 상태 조회로 확인한다. 정산이 끝난 뒤에는 API 취소가 막혀 settled_manual로 접수만 받는다.'
}

Table "shipping" {
  "id" BIGINT [pk, not null, increment]
  "order_group_id" BIGINT [not null]
  "recipient_name" VARCHAR(50) [not null]
  "phone" VARCHAR(20) [not null]
  "postal_code" VARCHAR(10)
  "address1" VARCHAR(255) [not null]
  "address2" VARCHAR(255)
  "memo" VARCHAR(200)
  "carrier" VARCHAR(50)
  "tracking_no" VARCHAR(50)
  "shipped_at" DATETIME(6)
  "updated_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    order_group_id [unique, name: "uk_shipping_group"]
  }

  Note: '배송지 스냅샷과 송장. 앞부분은 /pay 에서 buyer_address 를 그대로 떠 오고 뒷부분은 셀러가 발송 처리 때 채운다. 주문 당시 주소를 굳히는 것이 목적이라 마스터를 참조하지 않고 복사한다. 묶음 배송이므로 묶음당 1건이며, 분할 배송을 도입하면 이 유니크 제약을 풀고 1:N으로 바꾼다.'
}

Table "outbox" {
  "id" BIGINT [pk, not null, increment]
  "aggregate_type" VARCHAR(30) [not null, note: 'ORDER_GROUP, ORDER, SALE_FORM, PAYMENT']
  "aggregate_id" BIGINT [not null]
  "event_type" VARCHAR(50) [not null]
  "payload" JSON [not null]
  "status" VARCHAR(20) [not null, default: 'PENDING', note: 'PENDING, SENT, DEAD']
  "retry_count" INT [not null, default: 0]
  "last_error" VARCHAR(500)
  "created_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  "sent_at" DATETIME(6)
  "next_attempt_at" DATETIME(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: '이 시각 전에는 집지 않는다. 실패 백오프와 처리 중 임대를 겸한다']

  Indexes {
    (status, next_attempt_at) [name: "idx_outbox_pending"]
  }

  Note: '알림톡 등 외부 발송 대기열. 상태 변경 트랜잭션 안에서 적재하고 릴레이가 나중에 발송한다. 확정되지 않은 사실은 절대 넣지 않는다 — 유령 알림이 나간다. FK 없이 aggregate_id로 느슨하게 참조. next_attempt_at 하나가 실패 백오프와 처리 중 임대를 겸한다 — 집어갈 때도 앞으로 밀어, 발송하는 동안 다른 인스턴스가 같은 행을 집어 알림톡이 두 번 나가는 일을 막는다. 프로세스가 죽으면 임대가 만료돼 자동으로 다시 잡힌다.'
}

// ---------------------------------------------------------------------
// 인프라 — 도메인은 아니지만 같은 스키마에 산다
// ---------------------------------------------------------------------

Table "SPRING_SESSION" {
  "PRIMARY_ID" CHAR(36) [pk, not null]
  "SESSION_ID" CHAR(36) [not null]
  "CREATION_TIME" BIGINT [not null]
  "LAST_ACCESS_TIME" BIGINT [not null]
  "MAX_INACTIVE_INTERVAL" INT [not null, note: '초 단위. server.servlet.session.timeout 이 들어온다']
  "EXPIRY_TIME" BIGINT [not null]
  "PRINCIPAL_NAME" VARCHAR(100)

  Indexes {
    SESSION_ID [unique, name: "SPRING_SESSION_IX1"]
    EXPIRY_TIME [name: "SPRING_SESSION_IX2"]
    PRINCIPAL_NAME [name: "SPRING_SESSION_IX3"]
  }

  Note: '세션 저장소. 톰캣 인메모리 대신 DB에 담아 배포해도 로그인이 유지된다. Spring Session 의 공식 스키마 그대로이므로 손대지 않는다 — 라이브러리가 이 컬럼명과 타입을 그대로 쿼리한다. 시각은 전부 epoch millis 이고, 만료 정리 스케줄러가 EXPIRY_TIME 으로 훑는다.'
}

Table "SPRING_SESSION_ATTRIBUTES" {
  "SESSION_PRIMARY_ID" CHAR(36) [not null]
  "ATTRIBUTE_NAME" VARCHAR(200) [not null]
  "ATTRIBUTE_BYTES" BLOB [not null]

  Indexes {
    (SESSION_PRIMARY_ID, ATTRIBUTE_NAME) [pk, name: "SPRING_SESSION_ATTRIBUTES_PK"]
  }

  Note: '세션에 담긴 값들. 지금은 로그인 사용자 한 행뿐이다. 자바 직렬화 바이트라 사람이 읽을 수 있는 형태가 아니어서 카카오 access token 은 여기 넣지 않는다. 세션이 지워지면 속성도 같이 지워진다.'
}

